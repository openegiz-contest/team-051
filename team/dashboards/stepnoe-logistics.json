      "fieldConfig": {
        "defaults": {
          "unit": "masst",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#69cbb6"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 7,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false,
            "axisGridShow": true,
            "axisCenteredZero": false,
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
